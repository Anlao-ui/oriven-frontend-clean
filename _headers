# Netlify response headers.
#
# Product films and their poster frames (index.html, "Oriven is built for the
# way you advertise"): reuse the browser's copy for a day, and for up to a
# week after that serve it while checking for a new version in the
# background. Without this, Netlify's default (max-age=0, must-revalidate)
# makes every visit re-check each film before it can play. If a film is ever
# replaced, give it a new file name so visitors get it at once.
/assets/films/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# The web manifest (favicon block on every page): its own MIME type. Netlify
# serves .webmanifest as application/octet-stream by default, and every
# response carries X-Content-Type-Options: nosniff (below).
/site.webmanifest
  Content-Type: application/manifest+json; charset=utf-8

# Every page: no framing by other sites (clickjacking), no MIME sniffing,
# referrer limited to the origin on other sites, no device APIs. No CSP here:
# the pages use inline scripts and third-party tags (Supabase, Stripe,
# consented Google Ads) that a CSP would have to list first.
/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(self "https://checkout.stripe.com")
